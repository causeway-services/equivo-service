{
  "name": "@causeway-services/equivo-service",
  "version": "0.1.0",
  "type": "module",
  "description": "Equivo is a public course on obstruction-measurement mathematics, built from its authored course material and the reusable education platform.",
  "scripts": {
    "build": "static-site-publisher build content public --config=victor.config.mjs",
    "test": "node --test themes/equivo/test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "themes",
    "victor.config.mjs",
    "wrangler.jsonc"
  ],
  "dependencies": {
    "@red-cup-engineering/education-platform-service": "0.2.5",
    "@red-cup-engineering/metrologic": "0.3.0",
    "@red-cup-engineering/static-site-publisher": "0.1.15",
    "@red-cup-engineering/markdown-engineering-services-section": "0.5.0",
    "@red-cup-engineering/signcell": "0.1.0",
    "@red-cup-engineering/signgraph": "0.1.0",
    "@red-cup-engineering/computer-data-engineering-services-section": "0.1.0"
  },
  "devDependencies": {
    "wrangler": "4.123.0",
    "@red-cup-engineering/signcraft": "0.1.0"
  }
}
